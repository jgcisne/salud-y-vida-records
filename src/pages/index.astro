---
import Base from '../layouts/Base.astro';
import Cielo from '../components/Cielo.astro';
import Icono from '../components/Icono.astro';
import Ic from '../components/Ic.astro';
import TarjetaCantico from '../components/TarjetaCantico.astro';
import Video from '../components/Video.astro';
import BotonCompartir from '../components/BotonCompartir.astro';
import BotonFavorito from '../components/BotonFavorito.astro';
import sitio from '../config/sitio.json';
import { canticosOrdenados, novedadesOrdenadas } from '../lib/datos';
import { versiculo } from '../lib/biblia';
import { fechaES } from '../lib/util';

const todos = await canticosOrdenados();
const destacados = (todos.filter((c) => c.data.destacado).length ? todos.filter((c) => c.data.destacado) : todos).slice(0, 12);
const videos = (sitio.youtube.videos as any[]).slice(0, 3);
const vd = sitio.versiculoDestacado;
const v = versiculo(vd.libro, vd.capitulo, vd.versiculo);
const novedades = (await novedadesOrdenadas()).slice(0, 3);
---
<Base titulo={sitio.nombre}>
  <section class="portada" aria-labelledby="titulo-portada">
    <Cielo />
    <div class="contenedor texto">
      <div class="icono-grande" style="width:96px"><Icono size={96} /></div>
      <h1 class="titulo-marca" id="titulo-portada">SALUD Y VIDA<span>RECORDS</span></h1>
      <p class="lema">{sitio.lema}</p>
      <div class="acciones">
        <a class="btn btn-oro" href="/top100"><Ic n="musica" /> ESCUCHAR CÁNTICOS</a>
        <a class="btn btn-claro" href="/youtube/"><Ic n="youtube" /> VER YOUTUBE</a>
        <a class="btn btn-claro" href="/biblia/"><Ic n="biblia" /> EXPLORAR LA BIBLIA</a>
      </div>
    </div>
    <div class="pie-portada"></div>
  </section>

  <section class="banda" aria-labelledby="t-destacados">
    <div class="contenedor">
      <div class="cab-seccion aparecer">
        <div>
          <h2 id="t-destacados">Cánticos destacados</h2>
          <p class="sub">La Palabra de Dios hecha canto. Cada cántico nace de un pasaje de la Santa Biblia (RVR1909).</p>
        </div>
        <div class="flechas">
          <button class="ic-btn" type="button" data-carrusel="#carrusel" data-dir="-1" aria-label="Ver cánticos anteriores"><Ic n="ant" /></button>
          <button class="ic-btn" type="button" data-carrusel="#carrusel" data-dir="1" aria-label="Ver más cánticos"><Ic n="sig" /></button>
        </div>
      </div>
      {destacados.length
        ? <div class="carrusel" id="carrusel" tabindex="0" aria-label="Carrusel de cánticos destacados">{destacados.map((c) => <TarjetaCantico c={c.data} id={c.id} />)}</div>
        : <div class="vacio"><h3>Pronto habrá cánticos aquí</h3></div>}
      <p style="margin-top:18px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn-oro" href="/top100">VER TOP 100 CÁNTICOS</a><a class="btn btn-borde" href="/musica/">Ver toda la biblioteca musical</a></p>
    </div>
  </section>

  {v && (
    <section class="banda alt" aria-label="Versículo destacado">
      <div class="contenedor versiculo aparecer">
        <blockquote><p style="margin:0">{v.texto}</p></blockquote>
        <cite>{v.referencia} (RVR1909)</cite>
        <div class="acciones">
          <a class="btn btn-borde" href={v.url}>Leer el capítulo</a>
          <BotonFavorito tipo="versiculo" id={`${vd.libro}-${vd.capitulo}-${vd.versiculo}`} titulo={`${v.referencia} (RVR1909)`} url={v.url} />
          <button class="ic-btn" type="button" data-copiar={`«${v.texto}» ${v.referencia} (RVR1909)`} aria-label="Copiar versículo"><Ic n="copiar" /></button>
          <BotonCompartir titulo={`${v.referencia} (RVR1909)`} url={v.url} texto={`«${v.texto}» ${v.referencia} (RVR1909)`} />
        </div>
      </div>
    </section>
  )}

  <section class="banda" aria-labelledby="t-videos">
    <div class="contenedor">
      <div class="cab-seccion aparecer">
        <div><h2 id="t-videos">Videos recientes</h2><p class="sub">Del canal {sitio.youtube.nombreCanal}.</p></div>
        <a class="btn btn-borde" href="/youtube/">Ir a la sección de YouTube</a>
      </div>
      {videos.length
        ? <div class="rejilla">{videos.map((x) => <Video v={x} />)}</div>
        : <div class="aviso info aparecer"><h3>Los videos aparecerán aquí al conectar el canal</h3><p style="margin:0">Todavía no se han configurado videos. No mostramos videos inventados: cuando agregue los identificadores reales en <code>src/config/sitio.json</code>, se mostrarán automáticamente.</p></div>}
    </div>
  </section>

  <section class="banda alt" aria-labelledby="t-mision">
    <div class="contenedor mision">
      <div class="aparecer">
        <h2 id="t-mision">Nuestra misión</h2>
        <p class="sub">Salud y Vida Records existe para proclamar la Palabra de Dios mediante cánticos, reflexiones y herramientas digitales que ayuden a las personas a conocer, recordar y meditar en las Escrituras.</p>
        <p style="color:var(--ink-2)">Fundado y producido por el {sitio.fundador}.</p>
        <a class="btn btn-oro" href="/nosotros/">Conocer más</a>
      </div>
      <div class="pilares aparecer">
        <div class="pilar"><svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" fill="rgba(242,199,92,.14)"/><path d="M22 36V18l14-3v18" fill="none" stroke="#f2c75c" stroke-width="2.4"/><circle cx="19" cy="36" r="3.5" fill="#f2c75c"/><circle cx="33" cy="33" r="3.5" fill="#f2c75c"/></svg><div><h3>Conocer</h3><p>Cánticos que llevan el texto bíblico al corazón y a la memoria.</p></div></div>
        <div class="pilar"><svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" fill="rgba(242,199,92,.14)"/><path d="M16 18h10a2 2 0 0 1 2 2v18a3 3 0 0 0-3-3h-9zM40 18H30a2 2 0 0 0-2 2v18a3 3 0 0 1 3-3h9z" fill="none" stroke="#f2c75c" stroke-width="2.2" stroke-linejoin="round"/></svg><div><h3>Recordar</h3><p>La Santa Biblia Reina-Valera 1909 completa, para leer y compartir.</p></div></div>
        <div class="pilar"><svg viewBox="0 0 56 56" aria-hidden="true"><circle cx="28" cy="28" r="27" fill="rgba(242,199,92,.14)"/><rect x="26.5" y="13" width="3" height="30" rx="1.5" fill="#f2c75c"/><rect x="18" y="21" width="20" height="3" rx="1.5" fill="#f2c75c"/></svg><div><h3>Meditar</h3><p>Reflexiones con un mismo centro: todo se trata de Jesús.</p></div></div>
      </div>
    </div>
  </section>

  {novedades.length > 0 && (
    <section class="banda" aria-labelledby="t-nov">
      <div class="contenedor">
        <div class="cab-seccion"><h2 id="t-nov">Novedades</h2><a class="btn btn-borde" href="/novedades/">Ver todas</a></div>
        <ul class="linea-tiempo">{novedades.map((n) => <li class="aparecer"><time datetime={n.data.fecha.toISOString()}>{fechaES(n.data.fecha)}</time><h3 style="margin:.2em 0 .3em">{n.data.titulo} {n.data.demo && <span class="etiqueta-demo">Ejemplo</span>}</h3><p style="margin:0;color:var(--ink-2)">{n.body}</p></li>)}</ul>
      </div>
    </section>
  )}
</Base>
