---
import Ic from './Ic.astro';
---
<section class="reproductor" id="reproductor" aria-label="Reproductor de música" transition:persist="reproductor">
  <audio id="audio" preload="none"></audio>
  <div class="fila-r">
    <div class="info">
      <div class="mini" id="r-mini" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" fill="none" stroke="#f2c75c" stroke-width="1.8"/><circle cx="6.5" cy="18" r="2.5" fill="#f2c75c"/><circle cx="17.5" cy="16" r="2.5" fill="#f2c75c"/></svg></div>
      <div style="min-width:0">
        <div class="t" id="r-titulo">—</div>
        <div class="r" id="r-ref"></div>
      </div>
    </div>
    <div class="centro">
      <div class="botones">
        <button class="ic-btn" type="button" id="r-ant" aria-label="Cántico anterior"><Ic n="ant" /></button>
        <button class="boton-play" type="button" id="r-play" aria-pressed="false" aria-label="Reproducir"><span class="i-play"><Ic n="play" /></span><span class="i-pausa"><Ic n="pausa" /></span></button>
        <button class="ic-btn" type="button" id="r-sig" aria-label="Cántico siguiente"><Ic n="sig" /></button>
      </div>
      <div class="progreso">
        <span id="r-actual">0:00</span>
        <input type="range" id="r-barra" min="0" max="1000" value="0" step="1" aria-label="Progreso del cántico" />
        <span id="r-total">0:00</span>
      </div>
    </div>
    <div class="derecha">
      <span class="lbl-vol" aria-hidden="true"><Ic n="vol" /></span>
      <input class="vol" type="range" id="r-vol" min="0" max="1" step="0.05" value="0.9" aria-label="Volumen" />
      <button class="ic-btn" type="button" id="r-cerrar" aria-label="Cerrar reproductor"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
    </div>
  </div>
</section>
