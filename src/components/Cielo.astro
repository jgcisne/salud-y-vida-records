<div class="cielo" aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
    <defs>
      <radialGradient id="c-luz" cx="50%" cy="72%" r="48%">
        <stop offset="0" stop-color="#fff6d6" stop-opacity="1" />
        <stop offset=".18" stop-color="#ffe29a" stop-opacity=".85" />
        <stop offset=".45" stop-color="#e3a93a" stop-opacity=".28" />
        <stop offset="1" stop-color="#0b1a3f" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="c-nube" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff4d2" />
        <stop offset=".35" stop-color="#c9b9a4" />
        <stop offset="1" stop-color="#3b4b7c" />
      </linearGradient>
      <linearGradient id="c-nube-o" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5b6a9e" />
        <stop offset="1" stop-color="#121f47" />
      </linearGradient>
      <filter id="c-suave" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="9" /></filter>
      <filter id="c-mas" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="22" /></filter>
      <symbol id="c-forma" viewBox="0 0 600 220" overflow="visible">
        <ellipse cx="120" cy="150" rx="120" ry="60" />
        <ellipse cx="230" cy="110" rx="110" ry="85" />
        <ellipse cx="340" cy="90" rx="120" ry="95" />
        <ellipse cx="450" cy="130" rx="110" ry="70" />
        <ellipse cx="300" cy="170" rx="300" ry="50" />
      </symbol>
    </defs>
    <!-- estrellas tenues -->
    <g fill="#fff8e6" opacity=".7">
      <circle cx="140" cy="90" r="1.4" /><circle cx="330" cy="150" r="1" /><circle cx="520" cy="60" r="1.6" /><circle cx="760" cy="110" r="1" />
      <circle cx="980" cy="70" r="1.3" /><circle cx="1180" cy="140" r="1" /><circle cx="1380" cy="80" r="1.6" /><circle cx="1510" cy="190" r="1" />
      <circle cx="250" cy="240" r="1" /><circle cx="1290" cy="250" r="1.1" /><circle cx="640" cy="210" r="0.9" /><circle cx="1050" cy="220" r="0.9" />
    </g>
    <!-- fuente de luz celestial detrás de las nubes -->
    <ellipse cx="800" cy="650" rx="760" ry="430" fill="url(#c-luz)" />
    <!-- nubes lejanas -->
    <g class="nube lenta" filter="url(#c-mas)" opacity=".85">
      <use href="#c-forma" x="-120" y="470" width="760" height="280" fill="url(#c-nube-o)" />
      <use href="#c-forma" x="980" y="450" width="800" height="300" fill="url(#c-nube-o)" />
    </g>
    <!-- nubes iluminadas -->
    <g class="nube" filter="url(#c-suave)">
      <use href="#c-forma" x="160" y="560" width="620" height="240" fill="url(#c-nube)" opacity=".92" />
      <use href="#c-forma" x="820" y="545" width="660" height="250" fill="url(#c-nube)" opacity=".92" />
    </g>
    <!-- banco de nubes en primer plano -->
    <g class="nube lenta" filter="url(#c-suave)">
      <use href="#c-forma" x="-200" y="700" width="900" height="300" fill="url(#c-nube-o)" />
      <use href="#c-forma" x="500" y="730" width="760" height="260" fill="url(#c-nube-o)" />
      <use href="#c-forma" x="1050" y="690" width="900" height="320" fill="url(#c-nube-o)" />
    </g>
    <!-- borde dorado donde la luz toca las nubes -->
    <ellipse cx="800" cy="640" rx="260" ry="34" fill="#fff1c2" opacity=".55" filter="url(#c-suave)" />
  </svg>
</div>
<div class="rayos" aria-hidden="true"></div>
