---
// Icono original de Salud y Vida Records: sol naciente dorado, cruz de luz
// y ondas sonoras que salen de la cruz (la Palabra proclamada en canto).
const { size = 44, title = '' } = Astro.props;
---
<svg class="icono" width={size} height={size} viewBox="0 0 64 64" role={title ? 'img' : 'presentation'} aria-hidden={title ? undefined : 'true'} aria-label={title || undefined}>
  <defs>
    <linearGradient id="ig-fondo" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#14254f"/><stop offset="1" stop-color="#070d1f"/></linearGradient>
    <radialGradient id="ig-sol" cx=".5" cy="1" r=".6"><stop offset="0" stop-color="#fff3c4"/><stop offset=".45" stop-color="#f2c75c"/><stop offset="1" stop-color="#c9952b"/></radialGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill="url(#ig-fondo)"/>
  <g stroke="#f2c75c" stroke-width="1.4" stroke-linecap="round" opacity=".55">
    <path d="M32 46 L12 30"/><path d="M32 46 L52 30"/><path d="M32 46 L20 22"/><path d="M32 46 L44 22"/>
  </g>
  <path d="M14 50 a18 18 0 0 1 36 0 z" fill="url(#ig-sol)"/>
  <rect x="30" y="10" width="4" height="35" rx="2" fill="#fff8e6"/>
  <rect x="22" y="19" width="20" height="4" rx="2" fill="#fff8e6"/>
  <g fill="none" stroke="#fff8e6" stroke-width="2" stroke-linecap="round" opacity=".9">
    <path d="M45.5 15.5a8 8 0 0 1 0 11"/><path d="M50 12a13 13 0 0 1 0 18"/>
    <path d="M18.5 15.5a8 8 0 0 0 0 11"/><path d="M14 12a13 13 0 0 0 0 18"/>
  </g>
  <rect x="10" y="50" width="44" height="2.4" rx="1.2" fill="#f2c75c"/>
</svg>
