---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import sitio from '../config/sitio.json';
import Icono from '../components/Icono.astro';
import Ic from '../components/Ic.astro';
import Reproductor from '../components/Reproductor.astro';

interface Props { titulo: string; descripcion?: string; imagen?: string; tipo?: string; jsonld?: object[]; sinIndice?: boolean }
const { titulo, descripcion = sitio.descripcion, imagen = '/img/og-portada.jpg', tipo = 'website', jsonld = [], sinIndice = false } = Astro.props;
const tituloCompleto = titulo === sitio.nombre ? `${sitio.nombre} — ${sitio.lema}` : `${titulo} | ${sitio.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const ogImg = new URL(imagen, Astro.site);
const ruta = Astro.url.pathname;
const menu = [
  ['/', 'Inicio'], ['/musica/', 'Cánticos'], ['/youtube/', 'YouTube'], ['/biblia/', 'Biblia'],
  ['/reflexiones/', 'Reflexiones'], ['/novedades/', 'Novedades'], ['/app/', 'App'], ['/nosotros/', 'Nosotros'], ['/contacto/', 'Contacto'],
];
const actual = (h: string) => (h === '/' ? ruta === '/' : ruta.startsWith(h));
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: sitio.nombre, slogan: sitio.lema,
  url: Astro.site?.href, logo: new URL('/img/icono-512.png', Astro.site).href,
  founder: { '@type': 'Person', name: 'Juan Cisneros' },
  ...(sitio.youtube.urlCanal ? { sameAs: [sitio.youtube.urlCanal, ...Object.values(sitio.redes).filter(Boolean)] } : {}),
};
---
<!doctype html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  {sinIndice && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#070d1f" />
  <meta property="og:type" content={tipo} />
  <meta property="og:site_name" content={sitio.nombre} />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={ogImg} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/img/icono-180.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Cinzel:wght@600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" />
  <script is:inline>
    try { const t = localStorage.getItem('syv-tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    document.addEventListener('astro:after-swap', () => { try { const t = localStorage.getItem('syv-tema'); if (t) document.documentElement.dataset.theme = t; } catch (e) {} });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  <ClientRouter fallback="swap" />
</head>
<body>
  <a class="salto" href="#contenido">Saltar al contenido</a>
  <header class="cabecera">
    <div class="contenedor fila">
      <a class="marca" href="/" aria-label={`${sitio.nombre}, ir al inicio`}>
        <Icono size={46} />
        <span class="nombre" aria-hidden="true">SALUD Y VIDA<small>RECORDS</small></span>
      </a>
      <nav aria-label="Principal">
        <ul class="menu" id="menu">
          {menu.map(([h, t]) => <li><a href={h} aria-current={actual(h) ? 'page' : undefined}>{t}</a></li>)}
        </ul>
      </nav>
      <a class="ic-btn" href="/buscar/" aria-label="Buscar cánticos, videos y pasajes"><Ic n="buscar" /></a>
      <button class="ic-btn" type="button" id="boton-tema" aria-label="Cambiar entre modo claro y oscuro"><span class="i-sol"><Ic n="sol" /></span></button>
      <button class="ic-btn boton-menu" type="button" id="boton-menu" aria-expanded="false" aria-controls="menu" aria-label="Abrir menú"><Ic n="menu" /></button>
    </div>
  </header>

  <main id="contenido" tabindex="-1"><slot /></main>

  <footer class="pie">
    <div class="contenedor">
      <div class="cols">
        <div>
          <a class="marca" href="/" style="margin-bottom:14px"><Icono size={52} /><span class="nombre">SALUD Y VIDA<small>RECORDS</small></span></a>
          <p style="font-family:var(--f-titulo);font-style:italic;font-size:24px;margin:10px 0 4px">{sitio.lema}</p>
          <p style="color:var(--ink-2)">Cánticos bíblicos y reflexiones basados en la Santa Biblia Reina-Valera 1909 (RVR1909).</p>
        </div>
        <div><h2>EXPLORAR</h2><ul><li><a href="/musica/">Cánticos</a></li><li><a href="/youtube/">Canal de YouTube</a></li><li><a href="/biblia/">Biblia RVR1909</a></li><li><a href="/reflexiones/">Reflexiones</a></li></ul></div>
        <div><h2>MINISTERIO</h2><ul><li><a href="/nosotros/">Sobre nosotros</a></li><li><a href="/novedades/">Novedades</a></li><li><a href="/app/">Aplicación</a></li><li><a href="/favoritos/">Mis favoritos</a></li></ul></div>
        <div><h2>CONTACTO</h2><ul><li><a href="/contacto/">Escríbanos</a></li>{sitio.youtube.urlCanal && <li><a href={sitio.youtube.urlCanal} rel="noopener" target="_blank">YouTube</a></li>}<li><a href="/contacto/#privacidad">Privacidad</a></li></ul></div>
      </div>
      <div class="firma"><strong>{sitio.firma}</strong>Las citas bíblicas son de la Santa Biblia Reina-Valera 1909 (RVR1909), de dominio público.</div>
    </div>
  </footer>

  <Reproductor />
  <script src="../scripts/app.ts"></script>
</body>
</html>
